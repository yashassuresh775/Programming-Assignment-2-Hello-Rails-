<%= form_with(model: movie, class: "movie-form") do |form| %>
  <% if movie.errors.any? %>
    <div class="form-errors" role="alert">
      <h2><%= pluralize(movie.errors.count, "error") %> prohibited this movie from being saved:</h2>
      <ul>
        <% movie.errors.each do |error| %>
          <li><%= error.full_message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title %>
    <%= form.text_field :title, required: true %>
  </div>

  <div class="field">
    <%= form.label :rating %>
    <%= form.text_field :rating, placeholder: "G, PG, PG-13, R, ..." %>
  </div>

  <div class="field">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 4 %>
  </div>

  <div class="field">
    <%= form.label :release_date %>
    <%= form.date_field :release_date %>
  </div>

  <div class="field actions">
    <%= form.submit class: "button primary" %>
  </div>
<% end %>
