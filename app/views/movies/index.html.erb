<% content_for :title, "RottenPotatoes — Movies" %>

<main class="page">
  <header class="page-header">
    <p class="brand">RottenPotatoes</p>
    <h1>Movies</h1>
    <p class="lede">Browse, sort, and manage the catalog.</p>
  </header>

  <% if notice.present? %>
    <p class="notice" role="status"><%= notice %></p>
  <% end %>

  <div class="actions-bar">
    <%= link_to "New movie", new_movie_path, class: "button primary" %>
  </div>

  <table class="movies-table" id="movies">
    <thead>
      <tr>
        <th scope="col"><%= sortable_column "title", "Title" %></th>
        <th scope="col"><%= sortable_column "rating", "Rating" %></th>
        <th scope="col"><%= sortable_column "release_date", "Release Date" %></th>
        <th scope="col">Actions</th>
      </tr>
    </thead>
    <tbody>
      <% @movies.each do |movie| %>
        <tr>
          <td><%= movie.title %></td>
          <td><%= movie.rating %></td>
          <td><%= movie.release_date&.strftime("%b %-d, %Y") %></td>
          <td class="row-actions">
            <%= link_to "Show", movie %>
            <%= link_to "Edit", edit_movie_path(movie) %>
            <%= button_to "Delete", movie, method: :delete, form: { class: "inline-form" }, class: "linkish-button" %>
          </td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="4"><%= pluralize(@movies.size, "movie") %> listed</td>
      </tr>
    </tfoot>
  </table>
</main>
